{application, tflite_beam,
 [{description, "TensorFlow Lite BEAM binding with optional TPU support."},
  {vsn, "0.4.0-rc6"},
  {registered, []},
  {applications,
   [kernel,
    stdlib
   ]},
  {env,[]},
  {modules, []},

  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/cocoa-xu/tflite_beam"}]},
  {include_paths, [
    "c_src/*.h",
    "c_src/*.cpp",
    "c_src/*.hpp",
    "c_src/coral",
    "c_src/tflite",
    "cc_toolchain",
    "scripts",
    "patches",
    "unicodedata",
    "CMakeLists.txt",
    "Makefile",
    ".gitmodules",
    "src",
    "README*",
    "LICENSE*",
    "rebar.config",
    "tflite_beam_precompiled.erl",
    "checksum.term"
  ]},
  {exclude_paths, [
    "priv",
    "c_src/libcoral",
    "c_src/metadata_schema.fbs",
    %% rebar3 leaves one of these wherever it is run and rebar3_hex packages from
    %% the filesystem rather than from git, so excluding it is what keeps a
    %% regenerated one out of the tarball
    "c_src/rebar.lock"
  ]},
  {doc, "doc"}
 ]
}.
