# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
tflite_beam-*.tar

# Temporary files, for example, from tests.
/tmp/
3rd_party/
.DS_Store
.vscode/
.idea/

# The directory rebar3 will write compiled artifacts to.
priv/
cmake_tflite_beam/
tflite_beam_precompiled.beam
# rebar3 leaves one of these wherever it is run, and c_src has no rebar.config
c_src/rebar.lock
# Generated between tagging and publishing by scripts/generate_checksums.sh: the
# tarballs it lists do not exist until the tag has been built, so a tracked copy
# is always one release out of date -- which is exactly how 0.4.0-rc4 shipped
# with rc3's manifest and refused to install.
checksum.term
libusb/

# built by TFLITE_BEAM_BUILD_TEST_PLUGIN, for the external-delegate tests
test/plugin/*.so
__pycache__/
